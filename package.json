{
  "name": "@ifrankwang/openspec-agents",
  "version": "0.121.0",
  "type": "module",
  "main": "./src/core/index.ts",
  "exports": {
    ".": {
      "import": "./src/core/index.ts",
      "types": "./src/core/index.ts"
    },
    "./core": {
      "import": "./src/core/index.ts",
      "types": "./src/core/index.ts"
    },
    "./provider": {
      "import": "./src/core/provider.ts",
      "types": "./src/core/provider.ts"
    },
    "./opencode": {
      "import": "./src/adapters/opencode/index.ts",
      "types": "./src/adapters/opencode/index.ts"
    },
    "./server": {
      "import": "./src/adapters/opencode/index.ts",
      "types": "./src/adapters/opencode/index.ts"
    },
    "./claude-code": {
      "import": "./src/adapters/claude-code/index.ts",
      "types": "./src/adapters/claude-code/index.ts"
    },
    "./codex": {
      "import": "./src/adapters/codex/index.ts",
      "types": "./src/adapters/codex/index.ts"
    },
    "./zcode": {
      "import": "./src/adapters/zcode/index.ts",
      "types": "./src/adapters/zcode/index.ts"
    },
    "./deepseek-harness": {
      "import": "./src/adapters/deepseek-harness/index.ts",
      "types": "./src/adapters/deepseek-harness/index.ts"
    },
    "./dsh": {
      "import": "./src/adapters/deepseek-harness/index.ts",
      "types": "./src/adapters/deepseek-harness/index.ts"
    },
    "./mcp": {
      "import": "./src/adapters/mcp-common/index.ts",
      "types": "./src/adapters/mcp-common/index.ts"
    },
    "./mcp/cli": {
      "import": "./src/adapters/mcp-common/cli.ts",
      "types": "./src/adapters/mcp-common/cli.ts"
    }
  },
  "files": [
    "src",
    "assets",
    "dsh",
    ".mcp-server"
  ],
  "scripts": {
    "sync": "bun scripts/sync.ts",
    "build:plugins": "bun scripts/build-plugins.ts",
    "build:dsh": "bun scripts/build-dsh-root.ts",
    "prepack": "bun run build:dsh",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.1.0",
    "@opencode-ai/plugin": "^1.17.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ifrankwang/openspec-agents"
  }
}
